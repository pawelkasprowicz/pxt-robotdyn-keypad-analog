{"entries":[{"timestamp":1794686889240,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":237,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":34,"diffs":[[1,""]]},{"start1":1,"length1":94,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":222,"length1":50,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":249,"length1":75,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"test.ts","value":"// tu są testy; nie będzie to kompilowane, gdy ten pakiet będzie używany jako rozszerzenie.\n"},{"type":"added","filename":"robotdyn_keypad.ts","value":"//% color=#00897B icon=\"\\uf11c\" block=\"RobotDyn Keypad\"\nnamespace robotdynKeypad {\n\n    let keypadPin: AnalogPin = AnalogPin.P0\n    let lastKey = \"\"\n    let currentKey = \"\"\n    let previousRaw = \"\"\n    let stableCount = 0\n    let initialized = false\n\n    const EVENT_ID = 7890\n\n    function readADC(): number {\n        return pins.analogReadPin(keypadPin)\n    }\n\n    function decodeKey(adc: number): string {\n        if (adc < 100) return \"\"\n        if (adc >= 979) return \"1\"\n        if (adc >= 897) return \"2\"\n        if (adc >= 825) return \"3\"\n        if (adc >= 764) return \"4\"\n        if (adc >= 711) return \"5\"\n        if (adc >= 665) return \"6\"\n        if (adc >= 624) return \"7\"\n        if (adc >= 589) return \"8\"\n        if (adc >= 556) return \"9\"\n        if (adc >= 527) return \"*\"\n        if (adc >= 501) return \"0\"\n        if (adc >= 450) return \"#\"\n        return \"\"\n    }\n\n    function scanKeyboard() {\n        basic.forever(function () {\n            let raw = decodeKey(readADC())\n\n            if (raw == previousRaw) {\n                if (stableCount < 3) stableCount++\n            } else {\n                previousRaw = raw\n                stableCount = 1\n            }\n\n            if (stableCount >= 2 && raw != currentKey) {\n                currentKey = raw\n\n                if (raw != \"\") {\n                    lastKey = raw\n                    control.raiseEvent(EVENT_ID, 1)\n                }\n            }\n\n            basic.pause(1)\n        })\n    }\n\n    /**\n     * Inicjalizuje klawiaturę na wybranym pinie analogowym.\n     */\n    //% block=\"inicjalizuj klawiaturę na pinie %pin\"\n    //% pin.defl=AnalogPin.P0\n    //% weight=100\n    export function init(pin: AnalogPin): void {\n        keypadPin = pin\n\n        if (!initialized) {\n            initialized = true\n            scanKeyboard()\n        }\n    }\n\n    /**\n     * Zwraca aktualnie wciśnięty klawisz.\n     */\n    //% block=\"odczytaj klawisz\"\n    //% weight=90\n    export function readKey(): string {\n        return currentKey\n    }\n\n    /**\n     * Sprawdza, czy wskazany klawisz jest wciśnięty.\n     */\n    //% block=\"czy naciśnięto %key\"\n    //% key.defl=\"1\"\n    //% weight=80\n    export function isPressed(key: string): boolean {\n        return currentKey == key\n    }\n\n    /**\n     * Zwraca ostatnio naciśnięty klawisz.\n     */\n    //% block=\"ostatni klawisz\"\n    //% weight=70\n    export function getLastKey(): string {\n        return lastKey\n    }\n\n    /**\n     * Uruchamia kod po naciśnięciu dowolnego klawisza.\n     */\n    //% block=\"po naciśnięciu klawisza\"\n    //% weight=60\n    export function onKeyPressed(handler: () => void): void {\n        control.onEvent(EVENT_ID, 1, handler)\n    }\n}"}]}],"snapshots":[{"timestamp":1794686889239,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"pxt-robotdyn-keypad-analog\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}}],"shares":[],"lastSaveTime":1794687250180}